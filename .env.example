# Docker Compose / 로컬 공통 (Git 커밋 금지 — .gitignore 의 .env)
# 통합 develop-env 의 DB_USERNAME / DB_PASSWORD / Kafka 를 그대로 사용한다.
DB_USERNAME=root
DB_PASSWORD=changeme

# 로컬 단독 실행 시 호스트 포트 (gateway application-local.yml 과 맞춤)
SERVER_PORT=8088
MYSQL_PORT=3308

MYSQL_DATABASE=plip_analytics
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
